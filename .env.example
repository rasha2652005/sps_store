# Copy this file to .env and fill it in (on a hosting platform, add these as environment variables instead).

# Port the website listens on (hosting platforms usually set this for you)
PORT=3000

# Where the database and uploaded photos are stored. On a host with a permanent disk, point this at that disk.
DATA_DIR=./data

# Hosts without a permanent disk (Render free plan): keep the data in a free Turso database (turso.tech).
# The shop downloads its data from Turso when it starts and saves every change back to it.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Your website address, used in links shared on WhatsApp/Facebook and in the sitemap
PUBLIC_URL=https://www.example.com

# Set to production on the live website (secure cookies, HTTPS-only)
NODE_ENV=production

# Optional: create the owner account automatically on the first start (otherwise open /admin and create it there)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Forgot the password? Put a new ADMIN_PASSWORD, set this to true, restart once, then remove it.
ADMIN_RESET_PASSWORD=

# Example catalog on first start (products with placeholder photos). Set to false to start with an empty shop.
SEED_DEMO=true
# Also add example orders, customers and discount codes (useful to try the admin, not for the live shop)
SEED_DEMO_EXTRAS=false
